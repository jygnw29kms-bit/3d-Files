[Unit]
Description=PRINTBENCH External NFC Reader Bridge
After=network-online.target printbench-collector.service
Wants=network-online.target

[Service]
Type=simple
User=printbench
Group=printbench
SupplementaryGroups=dialout
WorkingDirectory=/opt/printbench/repo/tools/printbench_collector
Environment=PYTHONUNBUFFERED=1
Environment=PRINTBENCH_READER_PORT=/dev/ttyACM0
Environment=PRINTBENCH_READER_BAUD=115200
EnvironmentFile=-/etc/printbench/reader.env
ExecStart=/usr/bin/python3 /opt/printbench/repo/tools/printbench_collector/reader_serial.py --port ${PRINTBENCH_READER_PORT} --baud ${PRINTBENCH_READER_BAUD}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/printbench/repo/tools/printbench_collector /etc/printbench/bambu.json
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
