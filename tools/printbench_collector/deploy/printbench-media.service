[Unit]
Description=PRINTBENCH server telemetry and on-demand camera
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=printbench
Group=printbench
WorkingDirectory=/opt/printbench/tools/printbench_collector
EnvironmentFile=/etc/printbench/server.env
ExecStart=/opt/printbench/.venv/bin/python /opt/printbench/tools/printbench_collector/daemon.py --server-media
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/printbench/tools/printbench_collector

[Install]
WantedBy=multi-user.target
